"        console.log('reconnect', err, retryCount)\n"
"        // Sleep for 1 second before retrying.\n"
"        await new Promise((resolve) => setTimeout(resolve, 1000))\n"
"\n"
"        return { reconnect: true }\n"
"      },\n"
"    })\n"
"\n"
